# ==============================================================================
# HB+ Intern Portal - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your Firebase and Google Cloud Console values.
# NEVER commit your actual '.env' file or private service accounts to version control!
#
# NOTE: EXPO_PUBLIC_* variables are bundled into the client app by Expo/Metro.
# Firebase Web API keys are public client identifiers (protected by Firestore Security
# Rules and OAuth Authorized Domains), NOT private server secrets.
# ==============================================================================

# --- Firebase Web Client Configuration ---
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app (</>)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyExamplePlaceholderKey123456789
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=hbplus-portal.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=hbplus-portal
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=hbplus-portal.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# --- Google OAuth Client IDs (Optional for native mobile, Web uses Firebase Auth Domain) ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789012-iosclientid.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=123456789012-androidclientid.apps.googleusercontent.com

# --- Optional Local Firebase Emulator Suite Configuration ---
# Set to 'true' if running local Firebase Emulator Suite (default: 'false')
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
